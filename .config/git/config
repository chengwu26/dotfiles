[user]
  name = kanggui
  email = kg.he@outlook.com

[alias]
  st = status -s
  lol = log --oneline --graph --all

[core]
  compression = 9

[init]
  defaultBranch = main

[column]
  ui = auto

[status]
  branch = true
  showStash = true

[branch]
  sort = -committerdate

[tag]
  sort = version:refname

[diff]
  algorithm = histogram
  colorMoved = default
  mnemonicPrefix = true
  renames = true

[push]
  default = simple
  autoSetupRemote = true
  followTags = true

[pull]
  rebase = true

[commit]
  verbose = true

[merge]
  conflictStyle = zdiff3

[rebase]
  # autoSquash = true
  # autoStash = true
  # updateRef = true
